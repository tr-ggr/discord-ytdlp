# Discord bot token (Developer Portal > your app > Bot > Reset Token)
DISCORD_TOKEN=

# storage.to personal API token (https://storage.to > Get API token)
STORAGE_TO_API_KEY=

# How long storage.to links stay alive (1-7 days on a free account)
STORAGE_TO_EXPIRY_DAYS=7

# Refuse videos longer than this
MAX_DURATION_MINUTES=90

# Default resolution for $yt-mp4 / $yt-dmmp4 (360, 480, 720, 1080, 1440, 2160)
DEFAULT_VIDEO_QUALITY=1080
